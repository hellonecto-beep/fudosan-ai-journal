---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.published_date.valueOf() - a.data.published_date.valueOf(),
);
const featured = posts[0];
const rest = posts.slice(1);

const CONTENT_TYPE_LABELS: Record<string, string> = {
	tool_intro: '自作ツール紹介',
	case_study: '自社実装ログ',
	news_analysis: 'ニュース解説',
	opinion: 'オピニオン',
};

const heroOf = (post: typeof posts[0]) => {
	const h = post.data.images?.find((i) => i.placement === 'hero');
	return h?.url ?? (h ? `/images/${h.filename}` : null);
};
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ===== ヒーロー（白基調・上質感） ===== */
			.hero {
				background: #ffffff;
				color: var(--navy);
				padding: 3em 1.5em 2.5em;
				text-align: center;
				border-bottom: 1px solid var(--border);
			}
			.hero-content {
				max-width: 820px;
				margin: 0 auto;
			}
			.hero .eyebrow {
				display: inline-block;
				color: var(--green-dark);
				font-size: 0.85em;
				font-weight: 700;
				letter-spacing: 0.15em;
				margin-bottom: 0.8em;
				padding-bottom: 0.4em;
				border-bottom: 2px solid var(--green);
			}
			.hero h1 {
				color: var(--navy);
				font-size: 2.1em;
				line-height: 1.5;
				margin: 0 0 0.7em;
				font-weight: 700;
				letter-spacing: 0.01em;
			}
			.hero .lead {
				color: var(--text-soft);
				font-size: 1em;
				margin: 0 0 1.5em;
				line-height: 1.9;
			}
			.hero .pills {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				flex-wrap: wrap;
				margin-top: 1em;
			}
			.hero .pill {
				background: #f1f5f9;
				color: var(--navy);
				padding: 5px 14px;
				border-radius: 6px;
				font-size: 0.82em;
				font-weight: 600;
			}

			/* ===== セクションコンテナ ===== */
			.section {
				max-width: 1080px;
				margin: 0 auto;
				padding: 3em 1em 1em;
			}
			.section-header {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 1.5em;
				border-bottom: 3px solid var(--green);
				padding-bottom: 0.6em;
			}
			.section-header h2 {
				color: var(--navy);
				font-size: 1.5em;
				margin: 0;
				display: flex;
				align-items: center;
				gap: 0.4em;
			}
			.section-header h2::before {
				content: '';
				display: inline-block;
				width: 6px;
				height: 1.2em;
				background: var(--green);
				border-radius: 2px;
			}
			.section-header .count {
				color: var(--text-muted);
				font-size: 0.9em;
			}

			/* ===== フィーチャーカード（最新記事1本） ===== */
			.featured-card {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 0;
				background: white;
				border-radius: var(--radius);
				overflow: hidden;
				box-shadow: var(--shadow-md);
				text-decoration: none;
				color: inherit;
				transition: 0.3s;
				margin-bottom: 2em;
			}
			.featured-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-lg);
			}
			.featured-img {
				width: 100%;
				height: 100%;
				min-height: 220px;
				max-height: 280px;
				object-fit: cover;
				display: block;
			}
			.featured-body {
				padding: 1.6em 1.8em;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-body .badge {
				display: inline-block;
				padding: 4px 12px;
				border-radius: 9999px;
				background: var(--green);
				color: white;
				font-size: 0.78em;
				font-weight: 700;
				margin-right: 8px;
			}
			.featured-body .featured-badge {
				background: var(--orange);
			}
			.featured-body .date {
				color: var(--text-muted);
				font-size: 0.85em;
			}
			.featured-body h3 {
				color: var(--navy);
				margin: 0.6em 0;
				font-size: 1.5em;
				line-height: 1.5;
			}
			.featured-body .excerpt {
				color: var(--text-soft);
				font-size: 0.95em;
				line-height: 1.75;
				margin: 0.5em 0 1em;
			}
			.featured-body .read-more {
				color: var(--green-dark);
				font-weight: 700;
				font-size: 0.9em;
			}

			/* ===== 通常記事カード ===== */
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			.post-card {
				display: flex;
				flex-direction: column;
				background: white;
				border-radius: var(--radius);
				overflow: hidden;
				box-shadow: var(--shadow-sm);
				text-decoration: none;
				color: inherit;
				transition: 0.2s;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-md);
			}
			.post-img-wrap {
				position: relative;
				aspect-ratio: 16 / 10;
				max-height: 200px;
				overflow: hidden;
				background: #f1f5f9;
			}
			.post-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: 0.3s;
			}
			.post-card:hover .post-img {
				transform: scale(1.04);
			}
			.post-card .badge-overlay {
				position: absolute;
				top: 12px;
				left: 12px;
				padding: 4px 11px;
				border-radius: 6px;
				background: rgba(20, 35, 59, 0.92);
				color: white;
				font-size: 0.78em;
				font-weight: 700;
				backdrop-filter: blur(4px);
			}
			.post-body {
				padding: 1.2em 1.4em 1.4em;
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			.post-body .date {
				color: var(--text-muted);
				font-size: 0.82em;
			}
			.post-body h3 {
				color: var(--navy);
				margin: 0.4em 0 0.5em;
				font-size: 1.1em;
				line-height: 1.55;
			}
			.post-body .excerpt {
				color: var(--text-soft);
				font-size: 0.88em;
				line-height: 1.7;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			/* ===== 「このメディアについて」帯 ===== */
			.about-strip {
				background: white;
				border-top: 4px solid var(--green);
				margin-top: 4em;
				padding: 2.5em 1.5em;
			}
			.about-strip .container {
				max-width: 820px;
				margin: 0 auto;
				text-align: center;
			}
			.about-strip h2 {
				color: var(--navy);
				font-size: 1.4em;
				margin: 0 0 0.6em;
			}
			.about-strip p {
				color: var(--text-soft);
				margin: 0.5em 0 1.2em;
				line-height: 1.9;
			}
			.about-strip .btn {
				display: inline-block;
				padding: 0.8em 1.8em;
				background: var(--navy);
				color: white;
				border-radius: 9999px;
				text-decoration: none;
				font-weight: 700;
				transition: 0.2s;
			}
			.about-strip .btn:hover {
				background: var(--green);
				transform: translateY(-2px);
			}

			@media (max-width: 720px) {
				.hero { padding: 2em 1em 1.5em; }
				.hero h1 { font-size: 1.5em; }
				.hero .lead { font-size: 0.95em; }
				.featured-card { grid-template-columns: 1fr; }
				.featured-img { min-height: 180px; max-height: 220px; }
				.featured-body { padding: 1.2em; }
				.featured-body h3 { font-size: 1.15em; }
				.post-grid { grid-template-columns: 1fr; gap: 1em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="width:100%;max-width:100%;padding:0;">
			<section class="hero">
				<div class="hero-content">
					<span class="eyebrow">FUDOSAN AI JOURNAL</span>
					<h1>AIで不動産業務を変えた人たちの記録</h1>
					<p class="lead">
						レガシーと言われ続けた業界が、AIで静かに変わり始めている。<br />
						現場の経営者・営業・事務員が「明日から動ける」よう翻訳して届けるメディアです。
					</p>
					<div class="pills">
						<span class="pill">自作ツール紹介</span>
						<span class="pill">自社実装ログ</span>
						<span class="pill">ニュース解説</span>
						<span class="pill">オピニオン</span>
					</div>
				</div>
			</section>

			{featured && (
				<div class="section">
					<div class="section-header">
						<h2>最新記事</h2>
						<span class="count">最新の1本</span>
					</div>
					<a class="featured-card" href={`/blog/${featured.id}/`}>
						{heroOf(featured) && (
							<img class="featured-img" src={heroOf(featured)!} alt={featured.data.images?.[0]?.alt ?? ''} loading="lazy" />
						)}
						<div class="featured-body">
							<div>
								<span class="badge featured-badge">最新</span>
								<span class="badge">{CONTENT_TYPE_LABELS[featured.data.content_type] ?? featured.data.content_type}</span>
								<span class="date"><FormattedDate date={featured.data.published_date} /></span>
							</div>
							<h3>{featured.data.title}</h3>
							<p class="excerpt">{featured.data.meta_description}</p>
							<div class="read-more">続きを読む →</div>
						</div>
					</a>
				</div>
			)}

			{rest.length > 0 && (
				<div class="section">
					<div class="section-header">
						<h2>他の記事</h2>
						<span class="count">{rest.length} 本</span>
					</div>
					<div class="post-grid">
						{rest.map((post) => {
							const src = heroOf(post);
							return (
								<a class="post-card" href={`/blog/${post.id}/`}>
									<div class="post-img-wrap">
										{src && <img class="post-img" src={src} alt={post.data.images?.[0]?.alt ?? ''} loading="lazy" />}
										<span class="badge-overlay">{CONTENT_TYPE_LABELS[post.data.content_type]}</span>
									</div>
									<div class="post-body">
										<span class="date"><FormattedDate date={post.data.published_date} /></span>
										<h3>{post.data.title}</h3>
										<p class="excerpt">{post.data.meta_description}</p>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			)}

			<div class="about-strip">
				<div class="container">
					<h2>運営：Necto（ネクト）</h2>
					<p>
						本メディアは、不動産会社向けAI業務効率化コンサル「Necto」が運営しています。営業AI・広報AI・メディアAIなど複数のAIエージェントを実際に運用しながら、その知見を業界に届けています。
					</p>
					<a class="btn" href="/about">このメディアについて詳しく</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
